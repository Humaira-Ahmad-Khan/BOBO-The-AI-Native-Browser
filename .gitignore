# Dependencies / build output (never committed, never downloaded here)
node_modules/
dist/
build/
out/
.next/
.turbo/
.cache/

# Python (project-local venv used only for the graphify tool)
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/

# graphify generated knowledge graph
graphify-out/

# Environment & secrets — hard rule: no credentials in the repo
*.vault
*.vault.*
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*

# Agent / editor state (keep rules, drop local noise)
.opencode/session/
.opencode/log/
.claude/settings.local.json
.cursor/sessions/
*.swp

# OS noise
Thumbs.db
Desktop.ini
.DS_Store

# Logs & coverage
*.log
npm-debug.log*
coverage/
.nyc_output/

# Local e2e screenshots (visual evidence, regenerated by `npm run smoke`)
tests/e2e/screenshots/

# Throw-away data and exports written by the e2e checks
tests/e2e/.tmp/
tests/.tmp/
